<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.finTrack.FinTrackController"
      spacing="10">

    <padding>
        <Insets top="20"
                right="20"
                bottom="20"
                left="20"/>
    </padding>

    <Label text="FinTrack Simples"/>

    <HBox spacing="10">

        <DatePicker fx:id="campoData"/>

        <TextField fx:id="campoDescricao"
                   promptText="Descrição"/>

        <TextField fx:id="campoValor"
                   promptText="Valor"/>

        <ComboBox fx:id="campoTipo"
                  promptText="Tipo"/>

    </HBox>

    <HBox spacing="10">

        <Button text="Adicionar"
                fx:id="botaoAdicionar"
                onAction="#adicionar"/>

        <Button text="Atualizar"
                fx:id="botaoAtualizar"
                onAction="#atualizar"/>

        <Button text="Remover"
                fx:id="botaoRemover"
                onAction="#remover"/>

    </HBox>

    <TableView fx:id="tabelaTransacoes">

        <columns>

            <TableColumn fx:id="colunaData"
                         text="Data"/>

            <TableColumn fx:id="colunaDescricao"
                         text="Descrição"/>

            <TableColumn fx:id="colunaValor"
                         text="Valor"/>

            <TableColumn fx:id="colunaTipo"
                         text="Tipo"/>

        </columns>

    </TableView>
    
    <HBox spacing="20">

        <Label fx:id="labelReceitas"
               text="Receitas: R$ 0,00"/>

        <Label fx:id="labelDespesas"
               text="Despesas: R$ 0,00"/>

        <Label fx:id="labelSaldo"
               text="Saldo: R$ 0,00"/>

    </HBox>

</VBox>